# Copia este archivo como secrets.toml (local) o pega su contenido en Streamlit Cloud > Settings > Secrets.
GEMINI_API_KEY = "tu_clave_de_gemini"

# Código secreto del creador/administrador (mínimo 10 caracteres; mejor una frase larga). Solo en secretos, NUNCA en el código ni en GitHub.
CODIGO_ADMIN = "una-frase-larga-y-secreta-solo-tuya"

# --- Firebase (base de datos y acceso con correo). Si lo omites, la app corre en MODO DEMO ---
FIREBASE_API_KEY = "la Web API Key del proyecto de Firebase"
ADMIN_EMAILS = "director@tuescuela.mx"          # correos que entran como administrador

# --- Opcionales ---
# ACCESO_GRUPO = "true"                          # alumnos entran con nombre + código de grupo (por defecto: activo si no hay Google/correo)
# IMAGENES_NATIVAS = "true"                      # "false" para volver al estilo de imagen anterior
# MODO_DEMO = "true"                             # solo para demostraciones: permite elegir un rol de prueba (APAGADO por defecto)
# ACCESO = "ambos"                               # "google", "correo" o "ambos"
# DOMINIO_PERMITIDO = "escuelamodelo.edu.mx"     # solo correos de este dominio entran con Google
# ACCESS_CODE = "codigo-modo-demo"
# ALERTAS_BIENESTAR = "true"            # avisar a orientación cuando un mensaje sugiere riesgo
# GUARDAR_TEXTO_FEEDBACK = "true"       # guardar pregunta/respuesta cuando alguien pulsa 👍/👎
# CODIGO_EJECUCION = "true"             # que Gemini calcule en Matemáticas y Ciencias
# LINEA_AYUDA = "Línea de la Vida: 800 911 2000 (gratuita, 24 horas)"
# COSTO_ENTRADA_POR_MILLON = "0.0"      # precios en USD por millón de tokens (de la página de precios de Google)
# COSTO_SALIDA_POR_MILLON = "0.0"
# GEMINI_MODEL_ESTUDIANTE = ""
# GEMINI_MODEL_DOCENTE = ""

# --- Las tablas van al final del archivo ---
[firebase_cuenta]    # contenido del JSON de la cuenta de servicio (Firebase > Configuración > Cuentas de servicio)
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"

# Inicio de sesión con Google (recomendado si la escuela usa cuentas de Google). Ver docs/CONFIGURAR_GOOGLE.md
[auth]
redirect_uri = "https://TU-APP.streamlit.app/oauth2callback"      # local: http://localhost:8501/oauth2callback
cookie_secret = "una-cadena-larga-y-aleatoria"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
